# Локализация
# Язык интерфейса Configurator по умолчанию.
VITE_DEFAULT_LOCALE=ru

# Backend
# Полный URL Endge Service Backend, с которым работает Configurator.
# Для локального Backend обычно используется http://localhost:8080.
VITE_ENDGE_SERVICE_BACKEND_URL=http://localhost:8080

# Workspace
# Workspace, который Configurator открывает после запуска.
VITE_ENDGE_WORKSPACE_IDENTITY=default

# Авторизация
# OIDC authorization endpoint для входа пользователя; оставьте пустым, если авторизация не нужна.
VITE_ENDPOINT_AUTH=https://auth.example.com/realms/example/protocol/openid-connect
# OIDC issuer, которому Configurator доверяет токены; оставьте пустым, если авторизация не нужна.
VITE_OIDC_ISSUER=https://auth.example.com/realms/example

# Sentry
# DSN проекта мониторинга; оставьте пустым, чтобы не настраивать Sentry.
VITE_SENTRY_DSN=
# Имя окружения, добавляемое к событиям Sentry.
VITE_SENTRY_ENVIRONMENT=
# Идентификатор версии Configurator, добавляемый к событиям Sentry.
VITE_SENTRY_RELEASE=

# Документация
# Полный http(s) URL; оставьте пустым, чтобы скрыть кнопку «Документация».
VITE_DOCUMENTATION_URL=
